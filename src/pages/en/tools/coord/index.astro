---
import Shell from '../../../../layouts/Shell.astro';
import Converter from '../../../../islands/Converter';
import MapPicker from '../../../../islands/MapPicker';
---

<Shell
  title="Coordinate Converter | WGS84 / GCJ02 / BD09 / CGCS2000 | XD Tools"
  description="Free online coordinate conversion between WGS-84, GCJ-02 (Mars), BD-09 (Baidu), and CGCS2000. Smart input parsing with map visualization."
  canonical="https://zhangleixd.com/en/tools/coord/"
>
  <div class="coord-page">
    <h1 class="coord-title">Coordinate Converter</h1>
    <p class="coord-subtitle">Enter coordinates in one system, see all four instantly</p>
    <Converter client:load />
    <div class="map-section">
      <h2 class="map-section-title">Map Preview</h2>
      <MapPicker client:visible />
    </div>
  </div>
</Shell>

<style>
  .coord-page { max-width: 960px; margin: 0 auto; padding: var(--space-section) var(--space-xl); }
  .coord-title { font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-xs); }
  .coord-subtitle { color: var(--color-text-secondary); margin-bottom: var(--space-xl); }
  .map-section { margin-top: var(--space-xl); }
  .map-section-title { font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-sm); }
</style>