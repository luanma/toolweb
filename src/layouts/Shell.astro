---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'XD工具箱 — 在线免费工具集合',
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'zh'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ? new URL(canonical, Astro.site).href : Astro.url.href} />
    {
      noindex && (
        <meta name="robots" content="noindex, follow" />
      )
    }
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand">XD<span class="navbar-brand-accent">工具箱</span></a>
        <div class="navbar-links" role="navigation" aria-label="主导航">
          <a href="/tools/coord/">坐标转换</a>
          <a href="/en/" hreflang="en">English</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-text">
          &copy; {new Date().getFullYear()} XD工具箱 · 坐标系转换精度约 1 米，仅供参考
        </p>
        <nav class="footer-links">
          <a href="/en/tools/coord/">Coordinate Converter (EN)</a>
        </nav>
      </div>
    </footer>
  </body>
</html>


<style>
  .navbar {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .navbar-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .navbar-brand {
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
    color: var(--color-text);
  }
  .navbar-brand-accent {
    color: var(--color-accent);
  }
  .navbar-links {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
  }
  .navbar-links a {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: color var(--duration-fast);
  }
  .navbar-links a:hover {
    color: var(--color-accent);
  }

  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-xl);
    margin-top: var(--space-section);
  }
  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .footer-text {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin: 0;
  }
  .footer-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .navbar-inner {
      padding: 0 var(--space-md);
    }
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>